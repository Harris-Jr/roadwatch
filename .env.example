# Copy this file to .env at the repo root and adjust as needed. .env is
# gitignored. Both backend/ and ai/ read from this same file when run via
# docker-compose.

# --- Database (backend) ---
DATABASE_URL=postgresql+psycopg2://roadwatch:roadwatch@db:5432/roadwatch

# --- Auth (backend) ---
# Generate a real secret with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=roadwatch-zambia
JWT_AUDIENCE=roadwatch-api

# Access tokens are short-lived JWTs; refresh tokens are long-lived and
# revocable (stored hashed in the refresh_sessions table). See the
# Authentication section in the README for the full flow.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Bcrypt cost factor for password hashing. 12 is a reasonable default;
# raise it if your server has headroom, but every +1 roughly doubles
# hashing time.
BCRYPT_ROUNDS=12

# Requests per 60-second window, per client IP (see backend/app/rate_limit.py
# for how this is enforced and its single-process limitation).
AUTH_RATE_LIMIT_LOGIN_PER_MINUTE=5
AUTH_RATE_LIMIT_REGISTER_PER_MINUTE=5
AUTH_RATE_LIMIT_REFRESH_PER_MINUTE=20

# Set to "production" to make the app refuse to start with the default/weak
# JWT_SECRET above (see Settings.validate_production_secrets in config.py).
ENVIRONMENT=development

# --- CORS (backend) ---
# Add your VPS domain here once deployed.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- ML model (ai) ---
# Optional — ai/ai/inference.py automatically looks for the model at
# ai/model/cct_modelcnn.h5 relative to the ai package itself, regardless of
# where the process is run from. Only set this if you want the file
# somewhere else (use an absolute path to avoid ambiguity).
# MODEL_PATH=/absolute/path/to/your-model.h5
MODEL_INPUT_SIZE=224

# --- File storage (backend) ---
UPLOAD_DIR=uploads

# --- Video processing (backend) ---
FRAME_SAMPLE_INTERVAL_SECONDS=1

# --- Routing (backend) ---
# Real route computation via a self-hosted OSRM instance. See the
# "Setting up real routing" section in the README for the one-time Zambia
# map data setup — this URL just points at the osrm service in
# docker-compose. Routing degrades to a straight-line estimate if this
# isn't reachable, so the app still runs before you've set this up.
OSRM_URL=http://osrm:5000

# --- Frontend ---
VITE_API_URL=http://localhost:8000
